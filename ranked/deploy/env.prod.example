# /opt/sp-ranked/.env on the server (chmod 600). Never commit the real file.
SP_RANKED_VERSION=ranked-0.1.0
POSTGRES_PASSWORD=change-me
ConnectionStrings__Db=Host=127.0.0.1;Port=5443;Database=ranked;Username=ranked;Password=change-me
Urls=http://127.0.0.1:8090

Ranked__PublicBaseUrl=https://ranked.tabletstrats.com
Ranked__ServerSecret=change-me-long-random
Ranked__Auth__DevLogin=false
Ranked__Auth__GoogleClientId=
Ranked__Auth__GoogleClientSecret=

# Optional: Discord announcements (webhook) and "Sign in with Discord" (OAuth app).
Ranked__Discord__WebhookUrl=
Ranked__Discord__ClientId=
Ranked__Discord__ClientSecret=

Ranked__Matchmaking__Mode=fifo
Ranked__Matchmaking__RatingUpdates=true

Ranked__GameServers__PublicHost=ranked.tabletstrats.com
Ranked__GameServers__PortRangeStart=12340
Ranked__GameServers__PortRangeEnd=12342
Ranked__GameServers__BackendUrlForServers=http://127.0.0.1:8090
