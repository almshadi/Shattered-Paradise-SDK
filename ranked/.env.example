# Copy to ranked/.env and fill in. Never commit .env.
# ASP.NET reads nested settings with "__" as separator.

# Shared secret between backend and spawned game servers (any long random string).
Ranked__ServerSecret=change-me

# Google OAuth "Web application" client (console.cloud.google.com -> APIs & Services -> Credentials)
Ranked__Auth__GoogleClientId=
Ranked__Auth__GoogleClientSecret=

# Testing helpers
Ranked__Auth__DevLogin=true
# fifo = pair first two in queue, mmr = rating-based pairing
Ranked__Matchmaking__Mode=fifo
# false = record results but never change ratings
Ranked__Matchmaking__RatingUpdates=true
